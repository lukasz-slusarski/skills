#!/usr/bin/env python3
# Summary of work handed to Kimi, GLM and Antigravity, from the cost logs written by kimi-run, glm-run and agy-run.
# Usage: delegation-report [--from YYYY-MM-DD] [--to YYYY-MM-DD]
# Logs live in $AI_DELEGATE_HOME (default ~/.config/ai-delegate): kimi-cost-log.jsonl, glm-cost-log.jsonl, agy-cost-log.jsonl.
import json, os, sys, collections, datetime as dt
args = sys.argv[1:]
frm = args[args.index("--from") + 1] if "--from" in args else "0000"
to = args[args.index("--to") + 1] if "--to" in args else "9999"
state = os.path.expanduser(os.environ.get("AI_DELEGATE_HOME", "~/.config/ai-delegate"))

def rows(name, engine):
    try:
        for line in open(os.path.join(state, name)):
            r = json.loads(line)
            day = dt.datetime.fromisoformat(r["ts"].replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d")
            if frm <= day <= to:
                yield day, r, engine
    except FileNotFoundError:
        return

agg = collections.defaultdict(lambda: {"n": 0, "ok": 0, "cost": 0.0, "secs": 0})
for day, r, e in (list(rows("kimi-cost-log.jsonl", "kimi")) + list(rows("glm-cost-log.jsonl", "glm"))
                  + list(rows("agy-cost-log.jsonl", "agy"))):
    if e == "kimi":
        key, ok, cost = (day, "kimi", "impl"), r.get("status") == "completed", r.get("requests", 0)
    elif e == "agy":
        key, ok, cost = (day, "agy/" + r.get("model", "?"), r.get("mode", "impl")), r.get("exit") == 0, r.get("pct_5h", 0)
    else:
        key, ok, cost = (day, r.get("model", "glm"), r.get("mode", "impl")), r.get("exit") == 0, r.get("credits", 0)
    a = agg[key]
    a["n"] += 1; a["ok"] += ok; a["cost"] += cost; a["secs"] += r.get("secs", 0)

if not agg:
    sys.exit("No log entries in the given range.")
print(f"{'day':10}  {'engine':22} {'mode':5}  {'tasks':>5}  {'ok':>3}  {'cost':>14}  {'avg time':>8}")
for (day, eng, mode), a in sorted(agg.items()):
    unit = "requests" if eng == "kimi" else "% 5h" if eng.startswith("agy/") else "credits"
    avg = f"{a['secs'] // a['n']}s" if a["secs"] else "-"
    c = f"{a['cost']:6.2f}" if eng.startswith("agy/") else f"{a['cost']:6.0f}"
    print(f"{day:10}  {eng:22} {mode:5}  {a['n']:5}  {a['ok']:3}  {c} {unit:>8}  {avg:>8}")
print("\nExample plan sizes (check your own plan): Kimi Plus 100 requests / 5 h, GLM Lite 2000 credits / 5 h and 10 000 / week,")
print("        Antigravity: % of the 5h window of its group (Claude/GPT or Gemini), current state: agy-limit.")
