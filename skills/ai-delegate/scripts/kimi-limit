#!/usr/bin/env python3
# Remaining Kimi Code quota (GET api.kimi.ai/coding/v1/usages, using the token that `kimi login` stored).
# The Kimi config directory is KIMI_HOME (default ~/.kimi-code). The token is only used for this one request.
# --json: {"remaining", "limit", "month_pct", "reset"} for scripts.
import glob, json, os, sys, urllib.error, urllib.request, datetime as dt
home = os.path.expanduser(os.environ.get("KIMI_HOME", "~/.kimi-code"))
files = sorted(glob.glob(os.path.join(home, "credentials", "*.json")), key=os.path.getmtime)
if not files:
    sys.exit(f"No Kimi credentials under {home}/credentials. Run `kimi login --region global`.")
tok = json.load(open(files[-1]))["access_token"]
req = urllib.request.Request("https://api.kimi.ai/coding/v1/usages", headers={"Authorization": f"Bearer {tok}", "User-Agent": "curl/8.7.1"})
try:
    d = json.load(urllib.request.urlopen(req, timeout=20))
except urllib.error.HTTPError as e:
    sys.exit(f"Error {e.code}. The token may have expired: run `kimi -p hi` or `kimi login --region global`.")
if "--json" in sys.argv:
    # raw numbers for scripts: requests left in the 5h window, month usage in %
    x = d["limits"][0]["detail"]
    print(json.dumps({"remaining": int(x.get("remaining", int(x["limit"]) - int(x.get("used", 0)))), "limit": int(x["limit"]),
                      "month_pct": round(d["usages"]["limit_month_total"]["used_ratio"] * 100, 2), "reset": x["resetTime"]}))
    sys.exit(0)
def t(s):
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone().strftime("%d.%m %H:%M")
names = {"limit_5h": "5h window", "limit_month_total": "Month (total)", "limit_month_code": "Month (code)"}
for k, v in d.get("usages", {}).items():
    print(f"{names.get(k, k):18} used {v['used_ratio']*100:5.1f}%   reset {t(v['reset_time'])}")
for l in d.get("limits", []):
    x = l["detail"]
    used = x.get("used", 0)
    left = x.get("remaining", int(x["limit"]) - int(x.get("used", 0)))
    print(f"{'Requests / 5h':18} {used}/{x['limit']} ({left} left)   reset {t(x['resetTime'])}")
